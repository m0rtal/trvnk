---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const plants = await getCollection("plants");
  return plants.map((plant) => ({
    params: { slug: plant.id },
    props: { plant },
  }));
}

const { plant } = Astro.props;
const { Content } = await render(plant);
const { data } = plant;
---
<Base title={`${data.title} — ${data.latin}`} description={data.range ?? data.common ?? ""}>
  <article class="plant">
    <header class="plant-header">
      <div class="plant-latin">{data.latin}</div>
      <h1 class="plant-title">{data.title}</h1>
      <div class="plant-meta">
        {data.common && <span class="tag">{data.common}</span>}
        {data.family && <span class="tag">{data.family}</span>}
        {data.habit && <span class="tag">{data.habit}</span>}
        {data.hardiness && <span class="tag">USDA {data.hardiness}</span>}
        {data.range && <span class="tag">{data.range}</span>}
        {data.height_m != null && <span class="tag">до {data.height_m} м</span>}
      </div>
    </header>

    <table class="plant-summary">
      <tbody>
        {data.habit && (
          <tr><th>Тип</th><td>{data.habit}</td></tr>
        )}
        {data.height_m != null && (
          <tr><th>Высота</th><td>до {data.height_m} м</td></tr>
        )}
        {data.family && (
          <tr><th>Семейство</th><td>{data.family}</td></tr>
        )}
        {data.common && (
          <tr><th>Общепринятое имя</th><td>{data.common}</td></tr>
        )}
        {data.hardiness && (
          <tr><th>USDA-зоны</th><td>{data.hardiness}</td></tr>
        )}
        {data.habit && data.habit.toLowerCase().includes("листопадн") && (
          <tr><th>Листопадность</th><td>Листопадное</td></tr>
        )}
        {data.range && (
          <tr><th>Ареал</th><td>{data.range}</td></tr>
        )}
        {data.habitats && (
          <tr><th>Местообитание</th><td>{data.habitats}</td></tr>
        )}
        {data.hazards && (
          <tr><th>Известные опасности</th><td>{data.hazards}</td></tr>
        )}
        {data.weed_potential && (
          <tr><th>Сорный потенциал</th><td>{data.weed_potential}</td></tr>
        )}
        <tr>
          <th>Съедобность</th>
          <td>
            {Array.from({ length: 5 }, (_, i) => (
              <span class={i < (data.edibility ?? 0) ? "rating-icon on" : "rating-icon off"}>★</span>
            ))}
            <span class="rating-num">({data.edibility ?? 0} из 5)</span>
          </td>
        </tr>
        <tr>
          <th>Лекарственное</th>
          <td>
            {Array.from({ length: 5 }, (_, i) => (
              <span class={i < (data.medicinal ?? 0) ? "rating-icon heart on" : "rating-icon heart off"}>♥</span>
            ))}
            <span class="rating-num">({data.medicinal ?? 0} из 5)</span>
          </td>
        </tr>
        <tr>
          <th>Прочее применение</th>
          <td>
            {Array.from({ length: 5 }, (_, i) => (
              <span class={i < (data.other_uses ?? 0) ? "rating-icon uses on" : "rating-icon uses off"}>✦</span>
            ))}
            <span class="rating-num">({data.other_uses ?? 0} из 5)</span>
          </td>
        </tr>
        {(data.care?.hardy || data.care?.well_drained || data.care?.moist ||
          data.care?.wet || data.care?.full_sun || data.care?.semi_shade ||
          data.care?.full_shade) && (
          <tr>
            <th>Уход</th>
            <td class="plant-care">
              {data.care?.hardy && <span class="care-icon" title="Морозостойкое"><span class="care-i">❄</span><span class="care-t">Морозостойкое</span></span>}
              {data.care?.well_drained && <span class="care-icon" title="Дренированная почва"><span class="care-i">◐</span><span class="care-t">Дренированная почва</span></span>}
              {data.care?.moist && <span class="care-icon" title="Умеренно влажная почва"><span class="care-i">◑</span><span class="care-t">Умеренно влажно</span></span>}
              {data.care?.wet && <span class="care-icon" title="Влажная или болотистая почва"><span class="care-i">●</span><span class="care-t">Влажно/болото</span></span>}
              {data.care?.full_sun && <span class="care-icon" title="Полное солнце"><span class="care-i">☀</span><span class="care-t">Полное солнце</span></span>}
              {data.care?.semi_shade && <span class="care-icon" title="Полутень"><span class="care-i">⛅</span><span class="care-t">Полутень</span></span>}
              {data.care?.full_shade && <span class="care-icon" title="Полная тень"><span class="care-i">☁</span><span class="care-t">Полная тень</span></span>}
            </td>
          </tr>
        )}
      </tbody>
    </table>

    {data.images && data.images.length > 0 && (
      <div class="plant-gallery">
        {data.images.map((src) => (
          <img src={src} alt={data.title} loading="lazy" />
        ))}
      </div>
    )}

    <div class="plant-content">
      <Content />
    </div>
  </article>
</Base>