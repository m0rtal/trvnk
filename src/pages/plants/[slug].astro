---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const plants = await getCollection("plants");
  return plants.map((plant) => ({
    params: { slug: plant.id },
    props: { plant },
  }));
}

const { plant } = Astro.props;
const { Content } = await render(plant);
const { data } = plant;
---
<Base title={`${data.title} — ${data.latin}`} description={data.range ?? data.common ?? ""}>
  <article class="plant">
    <header class="plant-header">
      <div class="plant-latin">{data.latin}</div>
      <h1 class="plant-title">{data.title}</h1>
      <div class="plant-meta">
        {data.common && <span class="tag">{data.common}</span>}
        {data.family && <span class="tag">{data.family}</span>}
        {data.habit && <span class="tag">{data.habit}</span>}
        {data.hardiness && <span class="tag">USDA {data.hardiness}</span>}
        {data.range && <span class="tag">{data.range}</span>}
        {data.height_m != null && <span class="tag">до {data.height_m} м</span>}
      </div>
    </header>

    <table class="plant-summary">
      <tbody>
        {data.habit && (
          <tr><th>Тип</th><td>{data.habit}</td></tr>
        )}
        {data.height_range && (
          <tr><th>Высота</th><td>{data.height_range}</td></tr>
        )}
        {data.family && (
          <tr><th>Семейство</th><td>{data.family}</td></tr>
        )}
        {data.common && (
          <tr><th>Общепринятое имя</th><td>{data.common}</td></tr>
        )}
        {data.habit && data.habit.toLowerCase().includes("листопадн") && (
          <tr><th>Листопадность</th><td>Листопадное</td></tr>
        )}
        {data.range && (
          <tr><th>Ареал</th><td>{data.range}</td></tr>
        )}
        {data.habitats && (
          <tr><th>Местообитание</th><td>{data.habitats}</td></tr>
        )}
        {data.hazards && (
          <tr><th>Известные опасности</th><td>{data.hazards}</td></tr>
        )}
        {data.hardiness_zone && (
          <tr><th>Морозостойкость</th><td><span class="care-icon" title="Шкала выносливости"><span class="care-i">{data.hardiness_zone}</span> <span class="care-t">{({H1:"Нежное, +10 °C",H2:"Полу-зимостойкое, 0 °C",H3:"Зимостойкое, −5 °C",H4:"Полностью зимостойкое, −15 °C",H5:"Очень зимостойкое, −20 °C",H6:"Максимально зимостойкое, ниже −20 °C"})[data.hardiness_zone] || data.hardiness_zone}</span></span></td></tr>
        )}
        {data.weed_potential && (
          <tr><th>Сорный потенциал</th><td>{data.weed_potential}</td></tr>
        )}
        <tr>
          <th>Съедобность</th>
          <td>
            {Array.from({ length: 5 }, (_, i) => (
              <span class={i < (data.edibility ?? 0) ? "rating-icon on" : "rating-icon off"}>★</span>
            ))}
            <span class="rating-num">({data.edibility ?? 0} из 5)</span>
          </td>
        </tr>
        <tr>
          <th>Лекарственное</th>
          <td>
            {Array.from({ length: 5 }, (_, i) => (
              <span class={i < (data.medicinal ?? 0) ? "rating-icon heart on" : "rating-icon heart off"}>♥</span>
            ))}
            <span class="rating-num">({data.medicinal ?? 0} из 5)</span>
          </td>
        </tr>
        <tr>
          <th>Прочее применение</th>
          <td>
            {Array.from({ length: 5 }, (_, i) => (
              <span class={i < (data.other_uses ?? 0) ? "rating-icon uses on" : "rating-icon uses off"}>✦</span>
            ))}
            <span class="rating-num">({data.other_uses ?? 0} из 5)</span>
          </td>
        </tr>
        {(data.soil?.well_drained || data.soil?.moist || data.soil?.wet || data.soil?.water) && (
          <tr>
            <th>Почва</th>
            <td class="plant-care">
              {data.soil?.well_drained && <span class="care-icon" title="Well Drained Soil — дренированная почва"><span class="care-i">◐</span><span class="care-t">Дренированная</span></span>}
              {data.soil?.moist && <span class="care-icon" title="Moist Soil — умеренно влажная"><span class="care-i">◑</span><span class="care-t">Умеренно влажно</span></span>}
              {data.soil?.wet && <span class="care-icon" title="Wet Soil — сырая, плохо дренированная"><span class="care-i">●</span><span class="care-t">Сырая</span></span>}
              {data.soil?.water && <span class="care-icon" title="Water Plants — водное растение"><span class="care-i">≈</span><span class="care-t">Водное</span></span>}
            </td>
          </tr>
        )}
        {(data.light?.full_sun || data.light?.part_shade || data.light?.full_shade) && (
          <tr>
            <th>Свет</th>
            <td class="plant-care">
              {data.light?.full_sun && <span class="care-icon" title="Full Sun — полное солнце"><span class="care-i">☀</span><span class="care-t">Полное солнце</span></span>}
              {data.light?.part_shade && <span class="care-icon" title="Part Shade — полутень"><span class="care-i">⛅</span><span class="care-t">Полутень</span></span>}
              {data.light?.full_shade && <span class="care-icon" title="Full Shade — полная тень"><span class="care-i">☁</span><span class="care-t">Полная тень</span></span>}
            </td>
          </tr>
        )}
      </tbody>
    </table>

    {data.images && data.images.length > 0 && (
      <div class="plant-gallery">
        {data.images.map((src) => (
          <img src={src} alt={data.title} loading="lazy" />
        ))}
      </div>
    )}

    <div class="plant-content">
      <Content />
    </div>
  </article>
</Base>