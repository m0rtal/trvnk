---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  // Structured data injection — pages can pass extra JSON-LD
  jsonLd?: object | object[];
  // Author and publisher info
  authorName?: string;
  datePublished?: string;
  dateModified?: string;
}

const {
  title = "trvnk — полезные растения",
  description = "Русскоязычный каталог полезных растений",
  canonical,
  ogType = "website",
  jsonLd,
  authorName = "trvnk",
  datePublished,
  dateModified,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://trvnk.ru";
const pageUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();

// Build JSON-LD: Organization (always) + custom data (page-specific)
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  name: "trvnk",
  url: siteUrl,
  description: "Русскоязычный каталог полезных растений",
  inLanguage: "ru-RU",
};

const websiteJsonLd = ogType === "website" ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  url: siteUrl,
  name: title,
  description,
  inLanguage: "ru-RU",
  publisher: { "@id": `${siteUrl}/#organization` },
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteUrl}/?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
} : null;

const customJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Compose final list — never duplicate Organization
const allJsonLd = websiteJsonLd
  ? [orgJsonLd, websiteJsonLd, ...customJsonLd]
  : [orgJsonLd, ...customJsonLd];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly site index" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM-friendly full content" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {datePublished && <meta name="article:published_time" content={datePublished} />}
    {dateModified && <meta name="article:modified_time" content={dateModified} />}
    {authorName && <meta name="author" content={authorName} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="trvnk" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="trvnk" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD structured data -->
    {allJsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">Перейти к содержимому</a>

    <header class="topbar" role="banner">
      <div class="container topbar-inner">
        <a href="/" class="brand" aria-label="trvnk — каталог полезных растений">
          <span class="brand-dot" aria-hidden="true"></span>
          <span>trvnk</span>
        </a>
        <nav aria-label="Основная навигация">
          <a href="/">Каталог</a>
          <a href="/about">О проекте</a>
        </nav>
      </div>
    </header>

    <main id="main" class="container" role="main">
      <slot />
    </main>

    <footer class="footer" role="contentinfo">
      <div class="container">
        <p>trvnk · Каталог полезных растений · 2026</p>
        <p class="footer-meta">
          <a href="/llms.txt">llms.txt</a> ·
          <a href="/llms-full.txt">llms-full.txt</a> ·
          <a href="/sitemap-index.xml">карта сайта</a>
        </p>
      </div>
    </footer>
  </body>
</html>
